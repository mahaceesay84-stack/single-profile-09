{
  "name": "muhammed-k-ceesay-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write index.html README.md *.json *.js *.ts src/**/*.{ts,tsx,css} .github/workflows/*.yml",
