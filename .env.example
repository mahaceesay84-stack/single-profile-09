# Create a form at https://formspree.io and add its endpoint here.
VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/your-form-id

# Set to true only after deploying and configuring the Cloudflare Worker.
VITE_ASSISTANT_ENABLED=false
VITE_ASSISTANT_API_URL=https://your-worker.your-subdomain.workers.dev

# The LLM runs only in the Cloudflare Worker; do not put its key in this file.
# Worker vars (workers/assistant/wrangler.toml):
# LLM_PROVIDER=groq
# LLM_ENDPOINT=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b
# Store the key with: npx wrangler secret put LLM_API_KEY
